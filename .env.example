# Copy this file to .env before deployment. Do not commit .env.

# MySQL and Redis credentials. Use long random values without spaces or '$'.
MYSQL_DATABASE=ai_chat
MYSQL_USERNAME=ai_chat
MYSQL_PASSWORD=replace_with_a_strong_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
REDIS_PASSWORD=replace_with_a_strong_redis_password

# At least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_jwt_secret

# Public HTTPS origin when an external reverse proxy is used. Do not add a trailing slash.
CORS_ALLOWED_ORIGINS=

# OpenAI-compatible Responses API configuration.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60s

# Set true only for the first deployment. deploy.sh resets it to false after
# the initial container has been created, so later restarts cannot bootstrap
# another administrator.
ADMIN_BOOTSTRAP_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_admin_password
INITIAL_ADMIN_NICKNAME=Administrator
